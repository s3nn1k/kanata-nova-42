(defcfg
  linux-dev-names-include ("AT Translated Set 2 keyboard")
  linux-continue-if-no-devs-found yes
  linux-output-device-name "kanata virtual keyboard"
  tap-hold-require-prior-idle 150
  concurrent-tap-hold yes
)

(deflocalkeys-linux
  zenkakuhankaku 85
  yen 124
  print 210
  menu 139
)

(defalias
  ctla (tap-hold 175 150 a lctl)
  ctlscln (tap-hold 175 150 scln lctl)
  alts (tap-hold 175 150 s lalt)
  altl (tap-hold 175 150 l lalt)
  metd (tap-hold 175 150 d lmet)
  metk (tap-hold 175 150 k lmet)
  sftf (tap-hold 175 150 f lsft)
  sftj (tap-hold 175 150 j lsft)
)

(defsrc
  zenkakuhankaku grv  1    2    3    4    5    6    7    8    9    0    min  eql  yen  bspc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  ssrq print slck pause nlck
  tab  q    w    e    r    t    y    u    i    o    p    rbrc ret
  caps a    s    d    f    g    h    j    k    l    scln bksl
  lsft z    x    c    v    b    n    m    comm Period Slash ro   rsft
  lctl lmet lalt muhenkan katakanahiragana henkan comp menu ralt rctl rmet
  ins  del  home end  pgup pgdn
  up   left down right
)

(deflayer base
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX
  grv  _    _    _    _    _    _    _    _    _    _    XX   XX
  tab  @ctla @alts @metd @sftf _    _    @sftj @metk @altl @ctlscln XX
  rbrc _    _    _    _    _    _    _    comm Period Slash bksl XX
  XX   XX   esc  (layer-while-held raise) (layer-while-held lower) ret bspc bspc XX XX XX
  XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX
)

(deflayer std
  zenkakuhankaku grv  1    2    3    4    5    6    7    8    9    0    min  eql  yen  bspc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  ssrq print slck pause nlck
  tab  _    _    _    _    _    _    _    _    _    _    rbrc ret
  caps a    s    d    f    _    _    j    k    l    scln bksl
  lsft _    _    _    _    _    _    _    comm Period Slash ro   rsft
  lctl lmet lalt muhenkan katakanahiragana henkan comp menu ralt rctl rmet
  ins  del  home end  pgup pgdn
  up   left down right
)

(deflayer lower
  _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _
  _    f1   f2   f3   f4   prev pgup pgdn home end  del  _    _
  _    f5   f6   f7   f8   pp   left down up   right _   _
  _    f9   f10  f11  f12  next vold volu brdn brup mute _    _
  _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _
  _    _    _    _
)

(deflayer raise
  _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _
  _    S-6  1    2    3    S-eql eql lbrc rbrc S-5  S-7  _    _
  _    S-3  4    5    6    min  S-min S-9 S-0  S-8  S-4  _
  _    _    7    8    9    0    S-1  S-lbrc S-rbrc S-2 _    _    _
  _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _
  _    _    _    _
)

(defchordsv2
  (muhenkan henkan) (layer-while-held std) 100 all-released ()
)
